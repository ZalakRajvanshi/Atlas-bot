# =============================================================================
# Atlas — environment configuration
# Copy to `.env` and fill in. Only the first two are required, and both are
# FREE. There is no paid API anywhere in this project.
# =============================================================================

# --- REQUIRED (both free) ----------------------------------------------------
# From @BotFather on Telegram (takes ~2 minutes)
TELEGRAM_BOT_TOKEN=

# From console.groq.com — free, no card required.
# This single key powers reasoning, tool calling, voice transcription
# (Whisper) and image reading.
GROQ_API_KEY=


# --- Deployment --------------------------------------------------------------
# Public HTTPS base URL of this service. Telegram webhooks require HTTPS.
# On Render this is https://<your-service-name>.onrender.com
PUBLIC_BASE_URL=

# Random string you invent. Telegram echoes it back so we can reject forgeries.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Postgres on Render; falls back to local SQLite when unset.
DATABASE_URL=


# --- OPTIONAL: better data, gracefully degrades without it --------------------
# finnhub.io free tier — real-time quotes, earnings calendar, company news.
# Without it Atlas uses Yahoo Finance: slightly delayed, still works.
FINNHUB_API_KEY=

# SEC EDGAR requires a UA string identifying you. No signup, no key.
SEC_USER_AGENT=Atlas Financial Assistant contact@example.com


# --- Models (all free on Groq) ------------------------------------------------
# Chosen by measurement: llama-3.3-70b-versatile failed tool calling on this
# project's 17-tool set; gpt-oss-120b passed every case at 0.6-0.9s.
ATLAS_MODEL=openai/gpt-oss-120b
ATLAS_FAST_MODEL=openai/gpt-oss-20b
ATLAS_WHISPER_MODEL=whisper-large-v3-turbo
# No vision model is available on Groq's free tier right now. Leave empty and
# Atlas tells users honestly it can't read images, instead of guessing.
ATLAS_VISION_MODEL=google/gemma-4-26b-a4b-it:free


# --- Tuning ------------------------------------------------------------------
LOG_LEVEL=INFO

# Alerts below this score (0-1) are never sent. Silence is a feature.
PROACTIVE_RELEVANCE_THRESHOLD=0.62

# Free-tier limits are per-minute; this caps concurrent model calls so a
# background sweep can never starve a live conversation.
MAX_CONCURRENT_LLM_CALLS=4

# Image reading. Free key from openrouter.ai — Groq's free tier has
# no vision model. Leave blank and Atlas says so honestly instead.
OPENROUTER_API_KEY=
